# GitHub Actions Dashboard - Environment Configuration
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development  # Options: development, testing, production
DEBUG=false              # Set to false in production
LOG_LEVEL=INFO           # Options: DEBUG, INFO, WARNING, ERROR

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=gha
POSTGRES_PASSWORD=  # REQUIRED: Set a strong password
POSTGRES_DB=github_actions
# For production, enable SSL:
# POSTGRES_SSL_MODE=require

# =============================================================================
# REDIS (Required for rate limiting and caching)
# =============================================================================
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=  # REQUIRED: Set a strong password

# =============================================================================
# SECURITY (Required)
# =============================================================================
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=  # REQUIRED: Set a strong secret key (min 32 chars)

# Authentication settings
REQUIRE_AUTHENTICATION=false  # Set to true to require auth on all endpoints

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================
# Create a GitHub Personal Access Token with repo and workflow scopes
GITHUB_TOKEN=  # Your GitHub PAT
GITHUB_WEBHOOK_SECRET=  # Secret for webhook signature validation
GITHUB_ORG=  # Your GitHub organization name

# =============================================================================
# LLM APIS (Optional - for AI-powered error analysis)
# =============================================================================
ANTHROPIC_API_KEY=  # For Claude-powered analysis
OPENAI_API_KEY=     # For embeddings

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100    # Requests per period
RATE_LIMIT_PERIOD=60       # Period in seconds

# =============================================================================
# CORS (Configure for your frontend URL in production)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# ALLOWED HOSTS (Configure for production)
# =============================================================================
# Comma-separated list of allowed host headers
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=  # REQUIRED: Set a strong password

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# =============================================================================
# SELF-MONITORING (Optional)
# =============================================================================
SELF_MONITORING_ENABLED=false
SELF_MONITORING_REPO=
