# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
# For local dev you may pick any password. In production this MUST be a strong
# random value — the app refuses to start if it matches a known default.
POSTGRES_USER=gha
POSTGRES_PASSWORD=replace-with-strong-dev-password
POSTGRES_DB=github_actions

# Redis — required by docker-compose; must match the REDIS_URL below.
REDIS_PASSWORD=replace-with-strong-dev-password

# GitHub
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_ORG=your_organization

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-your_key_here
OPENAI_API_KEY=sk-your_key_here

# Application
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-strong-random-64-char-value

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-strong-dev-password
